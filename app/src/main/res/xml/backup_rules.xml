<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 and lower (Android 12+ reads
   data_extraction_rules.xml). Keep both files in sync.
   See https://developer.android.com/guide/topics/data/autobackup

   echo_secure_prefs.xml is the EncryptedSharedPreferences file of
   SecureTokenStore. Its master key lives in the Android Keystore and is
   never backed up, so a restored copy can't be decrypted. Never back it up.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="echo_secure_prefs.xml" />
</full-backup-content>
