<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12+. Keep in sync with
   backup_rules.xml (Android 11 and lower).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   echo_secure_prefs.xml is the EncryptedSharedPreferences file of
   SecureTokenStore. Its master key lives in the Android Keystore and never
   leaves the device, so a restored or transferred copy can't be decrypted.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="echo_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="echo_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
